{
  "name": "dsh-sap-ai-core",
  "version": "0.1.0-rc.2",
  "description": "SAP AI Core multi-model provider for DeepSeek Harness with shared OAuth authentication",
  "license": "MIT",
  "author": "solstice621",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solstice621/dsh-sap-ai-core.git"
  },
  "homepage": "https://github.com/solstice621/dsh-sap-ai-core#readme",
  "bugs": {
    "url": "https://github.com/solstice621/dsh-sap-ai-core/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sap-ai-core",
    "llm",
    "qwen"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dsh-sap-ai-core-diagnose": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./diagnostic-host": {
      "types": "./dist/diagnostics/host.d.ts",
      "default": "./dist/diagnostics/host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "dsh": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "diagnose": "node --import tsx src/cli.ts",
    "test:live:cn40": "node --import tsx tests/live/cn40.ts",
    "test:live:expiry": "node --import tsx tests/live/expiry.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:contract": "node --import tsx --test tests/contract/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:pack": "node --import tsx scripts/test-pack.ts",
    "test:live:orchestration": "node --import tsx tests/live/orchestration.ts",
    "test:live:thinking": "node --import tsx tests/live/thinking.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-loop": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "dependencies": {
    "eventsource-parser": "3.0.6",
    "undici": "8.12.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@types/node": "24.10.0",
    "openai": "7.45.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
